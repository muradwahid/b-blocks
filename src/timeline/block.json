				"tablet": {
					"padding": {},
					"radius": {}
				},
				"mobile": {
					"padding": {},
					"radius": {}
				}
			}
		},
		"date": {
			"type": "object",
			"default": {
				"show": true,
				"color": "#1e1e1e",
				"typo": {
					"fontSize": {
						"desktop": "16px"
					}
				},
				"desktop": {
					"gap": "16px"
				},
				"tablet": {
					"gap": ""
				},
				"mobile": {
					"gap": ""
				}
			}
		},
