{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "b-blocks/toggle-content",
	"title": "Toggle Content",
	"category": "bBlocks",
	"description": "A clean toggle switch lets users click to switch between two content sections below the heading.",
