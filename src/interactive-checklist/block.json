{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "b-blocks/interactive-checklist",
	"version": "2.0.95",
	"title": "Interactive Checklist",
	"category": "bBlocks",
	"description": "A titled checklist of tickable items that visitors can check off, with their progress remembered in the browser via localStorage, an optional live completion indicator, and a reset button. Works without JavaScript using native checkbox inputs.",
	"keywords": [
		"checklist",
		"todo",
		"to-do",
		"task list",
		"tick list",
		"interactive checklist",
		"progress checklist",
		"setup checklist",
		"steps",
		"tasks"
	],
	"textdomain": "b-blocks",
	"attributes": {
		"headingText": {
			"type": "string",
			"default": "Your Checklist"
		},
		"headingTag": {
			"type": "string",
			"default": "h3"
		},
		"items": {
			"type": "array",
			"default": [
				{ "id": "item-1", "label": "First item", "checked": false },
				{ "id": "item-2", "label": "Second item", "checked": false },
				{ "id": "item-3", "label": "Third item", "checked": false }
			]
		},
		"showProgress": {
			"type": "boolean",
			"default": true
		},
		"showReset": {
			"type": "boolean",
			"default": true
		},
		"persistKey": {
			"type": "string",
			"default": ""
		},
		"checkboxStyle": {
			"type": "string",
			"default": "square"
		},
		"accentColor": {
			"type": "string",
			"default": "#4f46e5"
		},
		"cardBg": {
			"type": "string",
			"default": "#ffffff"
		},
		"textColor": {
			"type": "string",
			"default": "#1a1a1a"
		},
		"strikeChecked": {
			"type": "boolean",
			"default": true
		},
		"headingFontSize": {
			"type": "integer",
			"default": 20
		},
		"headingFontWeight": {
			"type": "string",
			"default": "700"
		},
		"itemFontSize": {
			"type": "integer",
			"default": 16
		},
		"itemFontWeight": {
			"type": "string",
			"default": "400"
		},
		"progressFontSize": {
			"type": "integer",
			"default": 13
		},
		"checkboxSize": {
			"type": "integer",
			"default": 20
		},
		"itemGap": {
			"type": "integer",
			"default": 12
		},
		"paddingVertical": {
			"type": "integer",
			"default": 24
		},
		"paddingHorizontal": {
			"type": "integer",
			"default": 28
		},
		"borderRadius": {
			"type": "integer",
			"default": 12
		},
		"borderColor": {
			"type": "string",
			"default": "#e5e7eb"
		},
		"borderWidth": {
			"type": "integer",
			"default": 1
		},
		"maxWidth": {
			"type": "integer",
			"default": 0
		},
		"alignment": {
			"type": "string",
			"default": "left"
		}
	},
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"html": false,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"example": {
		"attributes": {
			"preview": true
		}
	},
	"editorScript": "file:../index.js",
	"style": "file:./view.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
