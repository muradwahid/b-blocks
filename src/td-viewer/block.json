{
	"apiVersion": 3,
	"name": "b-blocks/td-viewer",
	"title": "3D Viewer",
	"description": "Display interactive 3D models on the web",
	"category": "bBlocks",
	"keywords": [
		"3d",
		"3d model",
		"3d viewer"
	],
	"textdomain": "b-blocks",
	"attributes": {
		"align": {
			"type": "string",
			"default": ""
		},
		"alignment": {
			"type": "string",
			"default": "center"
		},
		"sourceType": {
			"type": "string",
			"default": "upload"
		},
		"model": {
			"type": "object",
			"default": {
				"id": null,
				"url": "https://modelviewer.dev/assets/ShopifyModels/ToyTrain.glb",
				"title": ""
			}
		},
		"modelLink": {
			"type": "string",
			"default": "https://modelviewer.dev/assets/ShopifyModels/ToyTrain.glb"
		},
		"width": {
			"type": "string",
			"default": "100%"
		},
		"height": {
			"type": "string",
			"default": "350px"
		},
		"isTouchMove": {
			"type": "boolean",
			"default": true
		},
		"isZoom": {
			"type": "boolean",
			"default": true
		},
		"loadingType": {
			"type": "string",
			"default": "auto"
		},
		"poster": {
			"type": "string",
			"default": ""
		},
		"reveal": {
			"type": "string",
			"default": ""
		},
		"isProgressBar": {
			"type": "boolean",
			"default": true
		},
		"isLoadingPercent": {
			"type": "boolean",
			"default": false
		},
		"isAutoRotate": {
			"type": "boolean",
			"default": true
		},
		"rotationSpeed": {
			"type": "string",
			"default": ""
		},
		"autoRotateDelay": {
			"type": "string",
			"default": ""
		},
		"cameraOrbit": {
			"type": "string",
			"default": ""
		},
		"fieldOfView": {
			"type": "string",
			"default": ""
		},
		"interactionPrompt": {
			"type": "string",
			"default": ""
		},
		"autoplay": {
			"type": "boolean",
			"default": false
		},
		"animationName": {
			"type": "string",
			"default": ""
		},
		"isAnimationSelector": {
			"type": "boolean",
			"default": false
		},
		"variantName": {
			"type": "string",
			"default": ""
		},
		"isVariantSelector": {
			"type": "boolean",
			"default": false
		},
		"environmentImage": {
			"type": "string",
			"default": ""
		},
		"environmentImageUrl": {
			"type": "string",
			"default": ""
		},
		"skyboxImage": {
			"type": "string",
			"default": ""
		},
		"exposure": {
			"type": ["number", "string"],
			"default": ""
		},
		"shadowIntensity": {
			"type": ["number", "string"],
			"default": ""
		},
		"shadowSoftness": {
			"type": ["number", "string"],
			"default": ""
		},
		"isAR": {
			"type": "boolean",
			"default": false
		},
		"arMode": {
			"type": "string",
			"default": ""
		},
		"arPlacement": {
			"type": "string",
			"default": ""
		},
		"iosSrc": {
			"type": "string",
			"default": ""
		},
		"isFullscreen": {
			"type": "boolean",
			"default": false
		},
		"isZoomBtns": {
			"type": "boolean",
			"default": false
		},
		"isScreenshotBtn": {
			"type": "boolean",
			"default": false
		},
		"isDownloadBtn": {
			"type": "boolean",
			"default": false
		},
		"background": {
			"type": "object",
			"default": {}
		},
		"progressBarColor": {
			"type": "string",
			"default": ""
		},
		"posterColor": {
			"type": "string",
			"default": ""
		},
		"btnColor": {
			"type": "string",
			"default": ""
		},
		"btnBg": {
			"type": "object",
			"default": {}
		},
		"btnBorder": {
			"type": "object",
			"default": {}
		},
		"btnRadius": {
			"type": "object",
			"default": {}
		},
		"btnShadow": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"html": false
	},
	"example": {
		"attributes": {
			"preview": true,
			"sourceType": "link"
		}
	},
	"editorScript": "file:../index.js",
	"style": "file:./view.css",
	"render": "file:./render.php",
	"viewScript": [
		"file:./view.js",
		"modelViewer"
	]
}