{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "b-blocks/login-form",
    "version": "1.0.0",
    "title": "Login Form",
    "category": "bBlocks",
    "description": "Login form easily customize your login page.",
    "keywords": [
        "login",
        "form",
        "login form"
    ],
    "textdomain": "b-blocks",
    "attributes": {
        "align": {
            "type": "string",
            "default": ""
        },
        "form": {
            "type": "object",
            "default": {
                "fieldGap": "18px",
                "linkColor": "",
                "linkHovColor": "#ffa500"
            }
        },
        "labels": {
            "type": "object",
            "default": {
                "show": true,
                "username": "Username or Email Address",
                "password": "Password",
                "space": "0px",
                "color": "#484848",
                "typography": {
                    "fontSize": {
                        "desktop": 16
                    }
                }
            }
        },
        "formInput": {
            "type": "object",
            "default": {
                "size": "small",
                "username": "Username or Email Address",
                "password": "Password",
                "padding": {
                    "top": "10px",
                    "left": "10px",
                    "bottom": "10px",
                    "right": "10px"
                },
                "color": "",
                "typography": {
                    "fontSize": 16
                },
                "bgColor": "",
                "border": {},
                "radius":{},
                "icon": {
                    "show": true,
                    "color": "#000",
                    "position": 10,
                    "size": 18
                }
            }
        },
        "errorMessage": {
            "type": "object",
            "default": {
                "username": "Username or Email is required!",
                "password": "Password is required!",
                "typography": {
                    "fontSize": 12
                },
                "color": "#ff0000"
            }
        },
        "button": {
            "type": "object",
            "default": {
                "text": "Log In",
                "alignment": {
                    "desktop": "left",
                    "tablet": "left",
                    "mobile": "left"
                },
                "typography": {
                    "fontSize": {
                        "desktop": 15
                    }
                },
                "normal": {
                    "colors": {
                        "bg": {
                            "color": "#ffa500"
                        },
                        "text": "#f9f9f9"
                    },
                    "border": {},
                    "radius": {},
                    "shadow":[]
                },
                "hover": {
                    "colors": {
                        "bg": {
                            "color": "#ffa500"
                        },
                        "text": "#f9f9f9"
                    },
                    "border": {},
                    "radius": {},
                    "shadow": []
                },
                "padding": {
                    "top": "12px",
                    "left": "30px",
                    "bottom": "12px",
                    "right": "30px"
                },
                "animation": "none"
            }
        },
        "additional": {
            "type": "object",
            "default": {
                "loginRedirect": "",
                "logoutRedirect": "",
                "lostPass": true,
                "lostPassText": "Lost your password?",
                "remember": true
            }
        },
        "messages": {
            "type": "object",
            "default": {
                "type": "normal",
                "padding": {
                    "top": "10px",
                    "left": "10px",
                    "bottom": "10px",
                    "right": "10px"
                },
                "typography": {
                    "fontSize": {
                        "desktop": 14
                    }
                },
                "position": "",
                "normal": {
                    "color": {
                        "bg": {
                            "color": ""
                        },
                        "text": "#e36565"
                    },
                    "border": { },
                    "radius": {},
                    "padding": {
                        "top": "10px",
                        "left": "10px",
                        "bottom": "10px",
                        "right": "10px"
                    }
                },
                "success": {
                    "show": true,
                    "text": "Successfully logged in",
                    "color": {
                        "bg": "",
                        "text": ""
                    }
                },
                "error": {
                    "show": true,
                    "color": {
                        "bg": "#e36565",
                        "text": "#ffffff"
                    }
                }
            }
        },
        "advanced": {
            "type": "object",
            "default": {
                "dimension": {
                    "padding": {
                        "desktop": {
                            "top": "80px",
                            "right": "80px",
                            "bottom": "80px",
                            "left": "80px"
                        },
                        "tablet": {
                            "top": "40px",
                            "right": "40px",
                            "bottom": "40px",
                            "left": "40px"
                        },
                        "mobile": {
                            "top": "0px",
                            "right": "0px",
                            "bottom": "0px",
                            "left": "0px"
                        }
                    }
                },
                "borderShadow": {
                    "normal": {
                        "radius": {
                            "top": "0px",
                            "right": "0px",
                            "bottom": "0px",
                            "left": "0px"
                        },
                        "shadow": [
                            {
                                "hOffset": "0px",
                                "vOffset": "0px",
                                "blur": "0px",
                                "spreed": "0px",
                                "color": "#7090b000",
                                "isInset": false
                            }
                        ]
                    }
                },
                "background": {
                    "normal": {
                        "type": "color",
                        "color": "",
                        "gradient": {
                            "type": "radial",
                            "radialType": "ellipse",
                            "colors": [
                                {
                                    "color": "rgba(58, 66, 222, 1)",
                                    "position": "0"
                                },
                                {
                                    "color": "rgba(176, 195, 235, 1)",
                                    "position": "80"
                                }
                            ],
                            "centerPositions": {
                                "x": 50,
                                "y": 50
                            },
                            "angel": 90
                        },
                        "img": {
                            "url": "",
                            "desktop": {
                                "position": "center center",
                                "xPosition": 0,
                                "yPosition": 0,
                                "attachment": "",
                                "repeat": "no-repeat",
                                "size": "cover",
                                "customSize": "0px"
                            },
                            "tablet": {
                                "position": "center center",
                                "xPosition": 0,
                                "yPosition": 0,
                                "attachment": "",
                                "repeat": "no-repeat",
                                "size": "cover",
                                "customSize": "0px"
                            },
                            "mobile": {
                                "position": "center center",
                                "xPosition": 0,
                                "yPosition": 0,
                                "attachment": "",
                                "repeat": "no-repeat",
                                "size": "cover",
                                "customSize": "0px"
                            }
                        },
                        "transition": 0.3
                    }
                }
            }
        }
    },
    "supports": {
        "align": [
            "wide",
            "full"
        ],
        "html": false
    },
    "example": {
        "attributes": {}
    },
    "editorScript": "file:../index.js",
    "style": "file:./view.css",
    "render": "file:./render.php",
    "viewScript": [
        "file:./view.js",
        "wp-util"
    ]
}