		"advanced": {
			"type": "object",
			"default": {
				"dimension": {
					"padding": {
						"desktop": {
							"top": "0px",
							"right": "0px",
							"bottom": "0px",
							"left": "0px"
						},
						"tablet": {
							"top": "0px",
							"right": "0px",
							"bottom": "0px",
							"left": "0px"
						},
						"mobile": {
							"top": "0px",
							"right": "0px",
							"bottom": "0px",
							"left": "0px"
						}
					}
				},
				"borderShadow": {
					"normal": {
						"radius": {
							"top": "0px",
							"right": "0px",
							"bottom": "0px",
							"left": "0px"
						},
						"shadow": [
							{
								"hOffset": "0px",
								"vOffset": "0px",
								"blur": "0px",
								"spreed": "0px",
								"color": "#7090b000",
								"isInset": false
