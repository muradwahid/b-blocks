{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "b-blocks/woo-single-product",
	"title": "Woo Single Product",
	"category": "bBlocks",
	"description": "Embed a full, theme-consistent WooCommerce product purchase area — native gallery, variation form, quantity stepper, add-to-cart and meta — for any product anywhere, rendered through WooCommerce's own template hooks.",
	"keywords": [
		"woocommerce",
		"single product",
		"product page",
		"add to cart",
		"variations",
		"product gallery",
		"buy",
		"shop",
		"ecommerce"
	],
	"textdomain": "b-blocks",
	"attributes": {
		"productId": {
			"type": "integer",
			"default": 0
		},
		"layout": {
			"type": "string",
			"default": "horizontal"
		},
		"gallerySplit": {
			"type": "integer",
			"default": 50
		},
		"showGallery": {
			"type": "boolean",
			"default": true
		},
		"showSummary": {
			"type": "boolean",
			"default": true
		},
		"showAfterSummary": {
			"type": "boolean",
			"default": false
		},
		"columnGap": {
			"type": "integer",
			"default": 32
		},
		"maxWidth": {
			"type": "integer",
			"default": 0
		},
		"blockAlign": {
			"type": "string",
			"default": "center"
		},
		"paddingVertical": {
			"type": "integer",
			"default": 0
		},
		"paddingHorizontal": {
			"type": "integer",
			"default": 0
		},
		"blockBG": {
			"type": "string",
			"default": ""
		},
		"blockBorderRadius": {
			"type": "integer",
			"default": 0
		},
		"mobileStackOrder": {
			"type": "string",
			"default": "gallery-first"
		},
		"mobileBreakpoint": {
			"type": "integer",
			"default": 767
		},
		"noProductMessage": {
			"type": "string",
			"default": "Please select a product."
		}
	},
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"html": false,
		"customClassName": true
	},
	"example": {
		"attributes": {}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./view.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}