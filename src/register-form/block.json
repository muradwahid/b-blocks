          }
        },
        "admin": {
          "type": "default",
          "messageType": "HTML",
          "mail": {
            "subject": "New User Registration",
            "message": "<p>New user registration on your site gutenberg plugin development</p>\n<p>Username: [username]</p>\n<p>Email: [email]</p>"
          }
        }
