              },
              "mobile": {
                "position": "center center",
                "xPosition": 0,
                "yPosition": 0,
                "attachment": "",
                "repeat": "no-repeat",
                "size": "",
                "customSize": "0px"
              }
            },
            "video": {
              "url": "",
              "loop": false
            },
            "transition": 0.3
          }
