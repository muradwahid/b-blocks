{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "b-blocks/hero-section",
	"version": "2.0.71",
	"title": "Hero Section",
	"category": "bBlocks",
	"description": "Full-width landing-page hero with a large headline, optional eyebrow label and sub-headline, dual CTA buttons, and a background (color, gradient, image, or muted-autoplay video) with a configurable overlay for WCAG-AA text contrast.",
	"keywords": [
		"hero",
		"hero section",
		"landing page",
		"banner",
		"jumbotron",
		"masthead",
		"page header",
		"cta"
	],
	"textdomain": "b-blocks",
	"attributes": {
		"align": {
			"type": "string",
			"default": "full"
		},
		"minHeight": {
			"type": "string",
			"default": "60vh"
		},
		"contentAlign": {
			"type": "string",
			"default": "center"
		},
		"verticalAlign": {
			"type": "string",
			"default": "middle"
		},
		"contentMaxWidth": {
			"type": "number",
			"default": 800
		},
		"paddingTop": {
			"type": "number",
			"default": 96
		},
		"paddingBottom": {
			"type": "number",
			"default": 96
		},
		"paddingTopMobile": {
			"type": "number",
			"default": 64
		},
		"paddingBottomMobile": {
			"type": "number",
			"default": 64
		},
		"bgType": {
			"type": "string",
			"default": "color"
		},
		"bgColor": {
			"type": "string",
			"default": "#1a1a2e"
		},
		"bgGradientFrom": {
			"type": "string",
			"default": "#1a1a2e"
		},
		"bgGradientTo": {
			"type": "string",
			"default": "#16213e"
		},
		"bgGradientAngle": {
			"type": "number",
			"default": 135
		},
		"bgImageId": {
			"type": "number",
			"default": 0
		},
		"bgImageUrl": {
			"type": "string",
			"default": ""
		},
		"bgImageAlt": {
			"type": "string",
			"default": ""
		},
		"bgImagePosition": {
			"type": "string",
			"default": "center center"
		},
		"bgImageSize": {
			"type": "string",
			"default": "cover"
		},
		"bgVideoId": {
			"type": "number",
			"default": 0
		},
		"bgVideoUrl": {
			"type": "string",
			"default": ""
		},
		"bgVideoPosterId": {
			"type": "number",
			"default": 0
		},
		"bgVideoPosterUrl": {
			"type": "string",
			"default": ""
		},
		"overlayColor": {
			"type": "string",
			"default": "#000000"
		},
		"overlayOpacity": {
			"type": "number",
			"default": 40
		},
		"showEyebrow": {
			"type": "boolean",
			"default": false
		},
		"eyebrowText": {
			"type": "string",
			"default": "New — Summer 2026"
		},
		"eyebrowColor": {
			"type": "string",
			"default": "#ffffff"
		},
		"eyebrowBgColor": {
			"type": "string",
			"default": "rgba(255,255,255,0.14)"
		},
		"eyebrowFontSize": {
			"type": "number",
			"default": 13
		},
		"eyebrowFontWeight": {
			"type": "string",
			"default": "600"
		},
		"eyebrowLetterSpacing": {
			"type": "number",
			"default": 2
		},
		"headingText": {
			"type": "string",
			"default": "Build Something Amazing"
		},
		"headingTag": {
			"type": "string",
			"default": "h1"
		},
		"headingFontSize": {
			"type": "number",
			"default": 56
		},
		"headingFontSizeTablet": {
			"type": "number",
			"default": 40
		},
		"headingFontSizeMobile": {
			"type": "number",
			"default": 28
		},
		"headingFontWeight": {
			"type": "string",
			"default": "700"
		},
		"headingColor": {
			"type": "string",
			"default": "#ffffff"
		},
		"headingLineHeight": {
			"type": "number",
			"default": 120
		},
		"showSubHeading": {
			"type": "boolean",
			"default": true
		},
		"subHeadingText": {
			"type": "string",
			"default": "The easiest way to launch your next big idea — no code required."
		},
		"subHeadingFontSize": {
			"type": "number",
			"default": 18
		},
		"subHeadingFontSizeMobile": {
			"type": "number",
			"default": 15
		},
		"subHeadingColor": {
			"type": "string",
			"default": "rgba(255,255,255,0.85)"
		},
		"subHeadingMaxWidth": {
			"type": "number",
			"default": 600
		},
		"showPrimaryBtn": {
			"type": "boolean",
			"default": true
		},
		"primaryBtnText": {
			"type": "string",
			"default": "Get Started"
		},
		"primaryBtnUrl": {
			"type": "string",
			"default": ""
		},
		"primaryBtnNewTab": {
			"type": "boolean",
			"default": false
		},
		"primaryBtnBgColor": {
			"type": "string",
			"default": "#ffffff"
		},
		"primaryBtnTextColor": {
			"type": "string",
			"default": "#1a1a2e"
		},
		"primaryBtnHoverBgColor": {
			"type": "string",
			"default": "#e6e6f0"
		},
		"primaryBtnHoverTextColor": {
			"type": "string",
			"default": "#1a1a2e"
		},
		"primaryBtnBorderRadius": {
			"type": "number",
			"default": 6
		},
		"primaryBtnPaddingV": {
			"type": "number",
			"default": 14
		},
		"primaryBtnPaddingH": {
			"type": "number",
			"default": 28
		},
		"primaryBtnFontSize": {
			"type": "number",
			"default": 16
		},
		"primaryBtnFontWeight": {
			"type": "string",
			"default": "600"
		},
		"showSecondaryBtn": {
			"type": "boolean",
			"default": false
		},
		"secondaryBtnText": {
			"type": "string",
			"default": "Learn More"
		},
		"secondaryBtnUrl": {
			"type": "string",
			"default": ""
		},
		"secondaryBtnNewTab": {
			"type": "boolean",
			"default": false
		},
		"secondaryBtnVariant": {
			"type": "string",
			"default": "outline"
		},
		"secondaryBtnColor": {
			"type": "string",
			"default": "#ffffff"
		},
		"secondaryBtnTextColor": {
			"type": "string",
			"default": "#ffffff"
		},
		"secondaryBtnHoverBgColor": {
			"type": "string",
			"default": "rgba(255,255,255,0.14)"
		},
		"secondaryBtnHoverTextColor": {
			"type": "string",
			"default": "#ffffff"
		},
		"secondaryBtnBorderRadius": {
			"type": "number",
			"default": 6
		},
		"secondaryBtnPaddingV": {
			"type": "number",
			"default": 14
		},
		"secondaryBtnPaddingH": {
			"type": "number",
			"default": 28
		},
		"secondaryBtnFontSize": {
			"type": "number",
			"default": 16
		},
		"secondaryBtnFontWeight": {
			"type": "string",
			"default": "600"
		},
		"btnGap": {
			"type": "number",
			"default": 16
		}
	},
	"supports": {
		"align": ["wide", "full"],
		"html": false,
		"anchor": true,
		"className": true,
		"customClassName": true,
		"spacing": {
			"margin": true,
			"padding": false
		}
	},
	"example": {
		"attributes": {
			"preview": true
		}
	},
	"editorScript": "file:../index.js",
	"style": "file:./view.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
