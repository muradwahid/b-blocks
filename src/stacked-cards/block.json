{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "b-blocks/stacked-cards",
	"title": "Stacked Cards",
	"category": "bBlocks",
	"description": "Create interactive stacked card layouts that stay sticky while scrolling. The Stacked Cards block helps you present content in a layered, engaging format that enhances the user experience as visitors navigate your page.",
	"keywords": [
		"stacked",
		"cards",
		"stack",
		"cards"
	],
	"textdomain": "b-blocks",
	"attributes": {
		"align": {
			"type": "string",
			"default": ""
		},
		"options": {
			"type": "object",
			"default": {
				"effect": "default",
				"responsive": {
					"desktop": false,
					"tablet": true,
					"mobile": true
				}
			}
		},
		"styles": {
			"type": "object",
			"default": {
				"stickyTop": 30,
				"cardGaps": 30,
				"desktop": {
					"height": ""
				},
				"tablet": {
					"height": ""
				},
				"mobile": {
					"height": ""
				}
			}
		},
		"advanced": {
			"type": "object",
			"default": {
				"dimension": {
					"padding": {
						"desktop": {
							"top": "",
							"right": "",
							"bottom": "",
							"left": ""
						},
						"tablet": {
							"top": "",
							"right": "",
							"bottom": "",
							"left": ""
						},
						"mobile": {
							"top": "",
							"right": "",
							"bottom": "",
							"left": ""
						}
					},
