{
  "name": "b-blocks",
  "version": "2.0.34",
  "description": "Example block scaffolded with Create Block tool.",
  "author": "Wasek Bellah",
  "license": "ISC",
  "scripts": {
    "packages-update": "wp-scripts packages-update",
    "lint": "eslint src",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "format": "wp-scripts format",
    "start": "wp-scripts start --webpack-copy-php",
    "build": "wp-scripts build --webpack-copy-php && find . -name \".DS_Store\" -delete",
    "i18n-pot": "wp i18n make-pot . languages/b-blocks.pot --exclude=\"src\" && copy languages\\b-blocks.pot languages\\b-blocks-en_US.po",
    "i18n-json": "wp i18n make-json languages/ --no-purge",
    "i18n-mo": "wp i18n make-mo languages/",
    "i18n": "npm run i18n-pot && npm run i18n-json && npm run i18n-mo",
    "plugin-zip": "wp-scripts plugin-zip",
    "mac-zip": "zip -r b-blocks.zip assets build freemius includes languages index.php plugin.php readme.txt",
    "zip": "tar.exe acvf b-blocks.zip assets build freemius includes languages index.php plugin.php readme.txt",
    "bundle": "gulp clean && npm run lint && npm run build && npm run i18n && npm run zip",
    "fs-deploy": "gulp freemius-deploy",
    "remove-ds": "find . -name \".DS_Store\" -delete"
  },
  "dependencies": {
    "@gsap/react": "^2.1.1",
    "@tinymce/tinymce-react": "^6.0.0",
    "ace-builds": "^1.35.4",
    "animejs": "^3.2.1",
    "immer": "^10.1.1",
    "ogl": "^1.0.11",
    "plyr-react": "^5.3.0",
    "prismjs": "^1.30.0",
    "react-ace": "^14.0.1",
    "react-hot-toast": "^2.4.1",
    "react-inlinesvg": "^4.1.3",
    "react-responsive-masonry": "^2.2.0",
    "react-router-dom": "^7.8.0",
    "react-slick": "^0.30.2",
    "slick-carousel": "^1.8.1",
    "swiper": "^11.1.14",
    "typed.js": "^3.0.0"
  },
  "devDependencies": {
    "@wordpress/block-editor": "^14.0.0",
    "@wordpress/blocks": "^13.5.0",
    "@wordpress/components": "^28.5.0",
    "@wordpress/compose": "^7.5.0",
    "@wordpress/data": "^10.5.0",
    "@wordpress/i18n": "^5.5.0",
    "@wordpress/scripts": "^32.2.0",
    "css-loader": "^7.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-webpack-plugin": "^4.2.0"
  }
}
